# ============================================================
# 文件：.gitignore
# 用途：告诉 git 哪些文件不要提交
# 说明：带密码的 .env、用户上传的资料、向量库、虚拟环境都不该进版本库
# ============================================================

# ---------- 环境变量（含数据库密码、API Key，绝不提交） ----------
.env
.env.local
.env.*.local

# ---------- Python 运行时产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------- 虚拟环境 ----------
.venv/
venv/
ENV/
env/

# ---------- 测试与覆盖率 ----------
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---------- 数据（用户上传的资料、向量库、旧 SQLite） ----------
# 这些是运行时产生的，每个人的都不一样，不该进版本库
data/uploads/
data/chroma/
data/*.db
data/*.sqlite3

# ---------- 模型文件（很大，几百 MB，不该进版本库） ----------
models/

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 前端（阶段五才用，先留着） ----------
web/node_modules/
web/dist/
web/.vite/

# ---------- 日志 ----------
*.log
logs/