# ============================================================
# 文件：.env.example
# 用途：环境变量模板文件
#
# 【这个文件是什么】
#   它是一个"模板"。里面列出了项目需要用到的所有环境变量，
#   但填的是示例值（不是真实密码）。
#   别人 clone 你的代码后，看一眼就知道"我需要配哪些变量"。
#
# 【怎么用它】
#   1. 复制一份：cp .env.example .env
#   2. 打开 .env，把里面的值改成你自己的
#   3. 代码启动时会自动读 .env
#
# 【为什么不能直接把真实密码写在这里】
#   因为 .env.example 要提交到 git（它是给团队看的说明书），
#   一旦提交，密码就泄漏了。
#   所以真实密码只写在 .env 里，而 .env 被 .gitignore 排除掉，
#   永远不会进 git。
#
# 【书写规则（重要，写错就读不到）】
#   ✅ 正确：MYSQL_PORT=9999
#   ❌ 错误：MYSQL_PORT = 9999      （等号两边有空格）
#   ❌ 错误：MYSQL_PORT="9999"      （值被引号包住）
#   ❌ 错误：MYSQL_PORT= 9999       （等号后面有空格）
#
#   为什么这三种都错：python-dotenv 读的时候，
#   等号两边的东西都当成值的一部分。
#   写成 MYSQL_PORT="9999" 的话，读到的值是 "9999"（带引号），
#   然后 int("9999") 会报错。
#
# 【为什么要有空行】
#   空行只是为了人看着舒服，对程序没影响。
#   但建议每个分组之间留空行，方便以后找。
# ============================================================


# ============================================================
# MySQL 配置（持久存储）
# ============================================================
# MySQL 里存的是什么：题库、错题、试卷、成绩、用户、课程、资料
# 这些数据不能丢，所以存 MySQL（有磁盘持久化 + 事务保证）。

# MySQL 主机地址
# 127.0.0.1 表示"本机"。
# 为什么不用 localhost：在有些系统上 localhost 会走 IPv6，
# 而 Docker 映射的端口只监听 IPv4，会连不上。
# 用 127.0.0.1 强制走 IPv4，最稳。
MYSQL_HOST=127.0.0.1

# MySQL 端口
# 9999 是"宿主机端口"，不是容器里的端口。
# docker-compose.yml 里写的是 "9999:3306"，
# 意思是：把宿主机的 9999 映射到容器的 3306。
# 所以你从外面连要连 9999。
# 为什么不用默认的 3306：本机已经装了 MySQL，占用着 3306。
# 改端口要改两个地方：docker-compose.yml 的端口映射 + 这里的值。
MYSQL_PORT=9999

# MySQL 用户名
# study_user 是在 docker-compose.yml 里创建的（见 MYSQL_USER）。
# 为什么不用 root：日常操作不需要 root 权限，
# 用专用账号更安全（万一密码泄漏，损失可控）。
MYSQL_USER=study_user

# MySQL 密码
# 这个密码必须和 docker-compose.yml 里的 MYSQL_PASSWORD 一致。
# 不一致会报 "Access denied for user 'study_user'@'localhost'"。
MYSQL_PASSWORD=study_pass

# MySQL 数据库名
# study_db 是在 docker-compose.yml 里自动创建的（见 MYSQL_DATABASE）。
# MySQL 容器第一次启动时，会自动建这个库，不需要你手动 CREATE DATABASE。
MYSQL_DATABASE=study_db

# MySQL 连接池大小
# 连接池是什么：预先建好几条连接放着，用的时候直接拿，用完还回去。
# 为什么不每次新建连接：建立连接要做 TCP 握手 + 认证，
# 耗时几十毫秒，每次都新建会让页面很慢。
# 5 是个人项目的合理值：太大反而占资源（每条连接在 MySQL 侧占一个线程）。
MYSQL_POOL_SIZE=5


# ============================================================
# Redis 配置（缓存 + 临时数据）
# ============================================================
# Redis 里存的是什么：课程列表缓存、题目列表缓存、作答草稿、JWT 黑名单
# 这些都是"丢了能重建"的数据，所以存 Redis（内存，快）。
#
# 【重要原则】Redis 里绝不存唯一真相。
# 任何 Redis 数据的丢失，都必须能从 MySQL 重建。

# Redis 主机地址
# 与 MYSQL_HOST 同理，用 127.0.0.1 不走 localhost。
REDIS_HOST=127.0.0.1

# Redis 端口
# 9991 是宿主机端口（docker-compose.yml 里映射的）。
# 容器里 Redis 跑在 6379，映射到宿主机的 9991。
REDIS_PORT=9991

# Redis 密码
# 必须和 docker-compose.yml 里的 --requirepass 参数一致。
# 不一致会报 "NOAUTH Authentication required" 或 "WRONGPASS"。
REDIS_PASSWORD=redis123

# Redis 数据库编号
# Redis 默认有 16 个库，编号 0~15。
# 不同项目可以用不同库号隔离数据（但共享同一份内存）。
# 用 0 号库是最常见的做法。
REDIS_DB=0


# ============================================================
# JWT 配置（阶段四才用到，现在先占位）
# ============================================================
# JWT 是什么：用户登录后，服务器签发一个"令牌"（token）给前端。
# 前端后续请求都带上这个令牌，服务器就知道"你是谁"。
# 不需要服务器保存会话，所以叫"无状态认证"。

# 签名密钥
# 这是最重要的安全配置！用于签名 JWT，防止被伪造。
# 【必须改】上线前一定要换成一长串随机字符串。
# 怎么生成随机串：随便敲键盘敲 50 个字符，或者用在线 UUID 生成器。
# 改了之后所有已签发的 token 会失效（用户需要重新登录），这是正常的。
JWT_SECRET=change_me_to_a_long_random_string_please

# 签名算法
# HS256 = HMAC-SHA256，对称加密（加密和解密用同一个密钥）。
# 还有其他算法（RS256 等），但 HS256 对单体应用够用了。
JWT_ALGORITHM=HS256

# token 有效期（分钟）
# 120 分钟 = 2 小时。超过这个时间 token 失效，用户要重新登录。
# 太长：万一 token 泄漏，攻击者能用很久。
# 太短：用户体验差，老是要重新登录。
# 2 小时是常见折中值。
JWT_EXPIRE_MINUTES=120


# ============================================================
# LLM 配置（阶段三才用到，现在先占位）
# ============================================================
# LLM 是什么：大语言模型，用来生成题目、判分。
# 本项目用 OpenAI 兼容协议，所以任何支持这个协议的服务都能用。

# LLM 服务地址
# https://api.deepseek.com 是 DeepSeek 的官方地址（便宜，国内可访问）。
# 想换成别的：改成对应服务的地址即可。
# 常见选择：
#   https://api.deepseek.com           DeepSeek
#   https://dashscope.aliyuncs.com     通义千问
#   https://open.bigmodel.cn           智谱
#   http://localhost:8000/v1           本地 vLLM
LLM_BASE_URL=https://api.deepseek.com

# LLM API 密钥
# 【必须填，否则 LLM 功能用不了】
# 去对应服务的官网注册拿一个，然后填在这里。
# 注意：没填也能跑，只是题库未命中时不能生成新题（会报错）。
LLM_API_KEY=

# LLM 模型名
# deepseek-chat 是 DeepSeek 的通用对话模型。
# 改成你实际想用的模型名。
LLM_MODEL=deepseek-chat


# ============================================================
# 搜索引擎配置（阶段三才用到，现在先占位）
# ============================================================
# 用途：当资料不足时，用搜索引擎补充知识点相关的题目。

# 博查 API 密钥
# 去 https://open.bochaai.com 注册拿一个。
BOCHA_API_KEY=


# ============================================================
# 向量模型配置（M0 资料解析用）
# ============================================================
# 向量模型是什么：把文字转成一组数字（向量），用于"语义搜索"。
# 比如搜索"过错推定"，能找到"行为人被推定有过错"这种意思相近的段落。

# 向量模型路径
# 留空：从 HuggingFace 下载（需要网络，国内可能很慢或失败）。
# 填路径：用本地模型（先把模型下到本地，见 scripts/download_model.py）。
EMBEDDING_MODEL=

# HuggingFace 镜像地址
# 国内访问 HuggingFace 基本连不上，用这个镜像替代。
# 改了之后，下载模型会走镜像，速度快很多。
HF_ENDPOINT=https://hf-mirror.com